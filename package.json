{
	"name": "optim-evaluator-backend",
	"version": "1.0.0",
	"description": "Backend para OptimEvaluator - Sistema de Evaluación de Licitaciones",
	"main": "dist/server.js",
	"scripts": {
		"start": "node dist/server.js",
		"dev": "nodemon",
		"build": "tsc",
		"build:watch": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint src/**/*.ts --fix",
		"format": "prettier --write src/**/*.ts",
		"type-check": "tsc --noEmit",
		"docker:build": "docker build -t optim-evaluator-backend .",
		"docker:run": "docker run -p 3001:3001 optim-evaluator-backend",
		"docker:dev": "docker-compose up --build",
		"prepare": "chmod +x scripts/*.sh"
	},
	"keywords": [
		"licitaciones",
		"evaluacion",
		"pdf",
		"backend",
		"express",
		"typescript"
	],
	"author": "Optim People",
	"license": "MIT",
	"dependencies": {
		"@google/genai": "^1.9.0",
		"compression": "^1.7.4",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"express-rate-limit": "^7.1.5",
		"helmet": "^7.1.0",
		"mammoth": "^1.6.0",
		"multer": "^1.4.5-lts.1",
		"pdf-parse": "^1.1.1",
		"puppeteer": "^24.12.1",
		"winston": "^3.11.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.11",
		"@types/multer": "^1.4.11",
		"@types/node": "^20.10.5",
		"@types/pdf-parse": "^1.1.4",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "^6.16.0",
		"@typescript-eslint/parser": "^6.16.0",
		"eslint": "^8.56.0",
		"jest": "^29.7.0",
		"nodemon": "^3.0.2",
		"prettier": "^3.1.1",
		"supertest": "^6.3.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.3.3"
	}
}
